# ============================================
# Finance AI — Environment Variables
# ============================================
# Copy this file to .env and fill in values
# Never commit .env to version control
# .env files are always ignored by Git (.gitignore)

# --- Application Environment ---
# One of: development | testing | production (default: development)
# Selects the optional overlay config/{ENVIRONMENT}.yaml on top of
# config/default.yaml (see src/config/loader.py).
ENVIRONMENT=development

# --- Logging (overrides config logging.level / logging.format) ---
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Format: json | console
LOG_FORMAT=json

# --- Data Sources (Future) ---
# DATA_API_KEY=your_api_key_here
# DATA_API_SECRET=your_api_secret_here

# --- Database (Phase 2 only) ---
# The MVP is file-based (ADR-0005): no DATABASE_URL is needed.
# A PostgreSQL DATABASE_URL will be introduced with the Phase-2
# migration milestone.

# --- Misc ---
# DEBUG=false
